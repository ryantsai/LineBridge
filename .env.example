# Set process environment variables; this file is not automatically loaded.
LINE_BRIDGE_ADMIN_PORT=3210
LINE_BRIDGE_GATEWAY_PORT=3211
# LINE_BRIDGE_DATA=/path/to/persistent/linebridge-data
# CLI only, explicit direct-loopback development opt-in:
# LINE_BRIDGE_TRUST_LOCAL=1
# Optional helper executables, only for cross-host tunnel providers:
# LINE_BRIDGE_CLOUDFLARED=/usr/local/bin/cloudflared
# LINE_BRIDGE_TAILSCALE=/usr/bin/tailscale

# On your cloud AI client host:
# LINE_BRIDGE_URL=https://your-tunnel-hostname
# LINE_BRIDGE_TOKEN=...
# CF_ACCESS_CLIENT_ID=...
# CF_ACCESS_CLIENT_SECRET=...
