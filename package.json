{
  "name": "line-bridge",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "LineBridge: Rust/Tauri LINE account interface with encrypted SQLite storage and a scoped MCP/HTTP gateway",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "powershell -NoProfile -File scripts/start.ps1",
    "start:headless": "powershell -NoProfile -File scripts/start.ps1 -Headless",
    "build:protocol": "node scripts/build-protocol.mjs",
    "prepare:runtime": "powershell -NoProfile -File scripts/prepare-runtime.ps1",
    "desktop:dev": "npm run build:protocol && tauri dev",
    "desktop:build": "npm run build:protocol && npm run prepare:runtime && tauri build",
    "test:rust": "cargo test -p line-bridge-core",
    "start:legacy": "node server/main.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "express": "^5.1.0",
    "jose": "^6.2.12",
    "lineclientbot": "0.1.3",
    "qrcode": "^1.5.4",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.0",
    "esbuild": "^0.28.2"
  }
}
