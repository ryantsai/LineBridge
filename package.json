{
  "name": "line-bridge",
  "version": "0.3.0",
  "type": "module",
  "description": "LineBridge: headless LINE MCP/HTTP gateway with an encrypted SQLite inbox and a zh-TW web dashboard",
  "license": "UNLICENSED",
  "bin": {"linebridge": "bin/linebridge.mjs"},
  "files": ["bin/", "server/*.mjs", "protocol/*.mjs", "protocol/third-party-notices.txt", "public/", "examples/", "openapi.json", "README.zh-TW.md", "PACKAGING.md", "CONNECTIONS.md", "ALIASES.md"],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node bin/linebridge.mjs serve",
    "status": "node bin/linebridge.mjs status",
    "stop": "node bin/linebridge.mjs stop",
    "test": "node --test tests/*.test.mjs",
    "test:smoke": "node tests/service-smoke.mjs",
    "test:tunnel": "node tests/tunnel-smoke.mjs",
    "package": "node scripts/package.mjs",
    "check": "node scripts/check.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.27.1",
    "express": "^5.1.0",
    "jose": "^6.2.12",
    "lineclientbot": "0.1.3",
    "qrcode": "^1.5.4",
    "zod": "^3.25.76"
  }
}
