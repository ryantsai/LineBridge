{
  "name": "line-bridge",
  "version": "0.7.6",
  "type": "module",
  "description": "LineBridge portable LINE gateway with a browser dashboard, native tray and encrypted searchable archive",
  "license": "MIT",
  "bin": {
    "linebridge": "bin/linebridge.mjs"
  },
  "files": [
    "bin/",
    "client/*.mjs",
    "server/*.mjs",
    "protocol/*.mjs",
    "protocol/third-party-notices.txt",
    "public/",
    "examples/",
    "openapi.json",
    "LICENSE",
    "README.md",
    "README.en.md",
    "README.ja.md",
    "README.zh-TW.md",
    "PACKAGING.md",
    "CONNECTIONS.md",
    "ALIASES.md",
    "SEARCH.md",
    "CLI.md"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "node bin/linebridge.mjs serve",
    "status": "node bin/linebridge.mjs status",
    "stop": "node bin/linebridge.mjs stop",
    "test": "node --test tests/*.test.mjs",
    "test:cli": "node --test tests/cli*.test.mjs tests/client-credentials.test.mjs",
    "test:credentials:native": "node tests/client-credentials-native.mjs",
    "test:package-cli": "node tests/cli-package-smoke.mjs",
    "test:smoke": "node tests/service-smoke.mjs",
    "test:tunnel": "node tests/tunnel-smoke.mjs",
    "package": "node scripts/package.mjs",
    "package:portable": "node scripts/portable.mjs",
    "release": "node scripts/release.mjs",
    "version:bump": "node scripts/release.mjs bump",
    "release:tag": "node scripts/release.mjs tag",
    "publish:github": "node scripts/publish.mjs",
    "publish:portable": "node scripts/publish.mjs --kind portable",
    "publish:npm": "node scripts/publish.mjs --kind npm",
    "test:portable": "node tests/portable-smoke.mjs",
    "check": "node scripts/check.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.0",
    "express": "^5.2.1",
    "jose": "^6.2.12",
    "lineclientbot": "0.1.3",
    "qrcode": "^1.5.4",
    "undici": "^8.11.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "os": [
    "win32",
    "darwin"
  ]
}
