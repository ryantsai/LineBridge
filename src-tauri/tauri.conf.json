{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LineBridge",
  "version": "0.6.1",
  "identifier": "com.ryantsai.linebridge",
  "build": {
    "frontendDist": "../desktop"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
    }
  },
  "bundle": {
    "active": true,
    "shortDescription": "LINE 帳號、加密訊息封存與 AI 私人橋接",
    "category": "Utility",
    "resources": {
      "../runtime/app/": "app/",
      "../runtime/node-LICENSE.txt": "runtime/node-LICENSE.txt",
      "../runtime/node-source.json": "runtime/node-source.json",
      "../runtime/cloudflared-source.json": "runtime/cloudflared-source.json",
      "../runtime/tailcat-source.json": "runtime/tailcat-source.json",
      "../runtime/tailcat-LICENSE.txt": "runtime/tailcat-LICENSE.txt",
      "../tools/cloudflared-LICENSE.txt": "runtime/cloudflared-LICENSE.txt"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
